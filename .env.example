# csv_inspector settings. Copy to `.env` (git-ignored) in the directory you run
# the scripts from, or export these as environment variables instead.
# Reading them requires the cloud extra:
#   pip install -r agents/csv_inspector/requirements-cloud.txt
# Without it, the local backend runs with its built-in defaults.

# Default backend when --backend is not given: "local" (Ollama) or "api" (Gemini).
LLM_BACKEND=local

# --- Local backend (Ollama) --------------------------------------------------
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b

# --- Cloud backend (Google Gemini) -------------------------------------------
# NOTE: implemented and unit-tested with a mocked client, but not yet verified
# against the real service (no credentials were available). Tracked in
# https://github.com/deluispablo/data-agent-toolkit/issues/5
#
# Provide ONE of the two options below. If both are set, the API key wins.
#
# Option A: Gemini Developer API with an API key (https://aistudio.google.com/apikey).
# Never commit a real key.
GEMINI_API_KEY=
#
# Option B: Vertex AI with Application Default Credentials
# (run `gcloud auth application-default login` first).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

CLOUD_MODEL=gemini-2.5-flash
CLOUD_FALLBACK_MODEL=gemini-2.5-flash
