# Settings of the csv_inspector_api example. Copy to .env and pass it to the
# server: uv run uvicorn --app-dir src csv_inspector_api.app:create_app --factory --env-file .env
# Every variable is optional; unset ones keep the defaults shown.

# Model backend: "local" (Ollama, free) or "api" (Gemini, needs the cloud settings below).
CSV_INSPECTOR_API_LLM_BACKEND=local
# Primary local Ollama model.
CSV_INSPECTOR_API_OLLAMA_MODEL=qwen2.5-coder:7b
# Fallback local Ollama model, tried when the primary one fails.
CSV_INSPECTOR_API_OLLAMA_FALLBACK_MODEL=qwen2.5-coder:3b

# Primary cloud model (api backend only); unset keeps the library default.
# CSV_INSPECTOR_API_CLOUD_MODEL=gemini-2.5-flash
# Fallback cloud model (api backend only); unset keeps the library default.
# CSV_INSPECTOR_API_CLOUD_FALLBACK_MODEL=gemini-2.5-flash-lite
# Gemini Developer API key (api backend, Gemini Developer API mode). Never commit it.
# CSV_INSPECTOR_API_GEMINI_API_KEY=
# Google Cloud project (api backend, Vertex AI mode); also the project of the
# Cloud Storage client of POST /inspect/gcs (unset: inferred from the credentials).
# CSV_INSPECTOR_API_GOOGLE_CLOUD_PROJECT=
# Google Cloud location (api backend, Vertex AI mode).
# CSV_INSPECTOR_API_GOOGLE_CLOUD_LOCATION=

# POST /inspect/gcs reads Cloud Storage with Application Default Credentials
# (the [gcs] extra). Locally, prefer `gcloud auth application-default login`;
# on Cloud Run, the service account of the service. Only if you must use a
# service-account key file, point the standard Google variable at it (read by
# the Google SDK, not by this API; never commit the key):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# Time budget of one inspection request, in seconds.
CSV_INSPECTOR_API_DEFAULT_TIMEOUT_SECONDS=60
# Largest time budget a request may ask for, in seconds.
CSV_INSPECTOR_API_MAX_TIMEOUT_SECONDS=300
# Largest accepted upload, in bytes (256 MiB); larger uploads are rejected with 413.
CSV_INSPECTOR_API_MAX_UPLOAD_BYTES=268435456

# Let a request switch a local deployment to backend=api (the paid cloud
# backend) or pick the models of a cloud call. Cloud calls cost money: with
# true, any caller can spend your quota. Off, such requests get 403.
CSV_INSPECTOR_API_ALLOW_BACKEND_OVERRIDE=false
