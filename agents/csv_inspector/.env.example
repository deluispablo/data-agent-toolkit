# csv-inspector settings for the CLIs (csv-inspector, main_demo.py,
# eval_samples.py). Copy to `.env` (git-ignored) in the directory you run them
# from, pass another file with --env-file, or export these as environment
# variables instead (environment variables always win).
#
# The LIBRARY never reads a .env file implicitly: hosts either inject
# csv_inspector.Settings(...) or call load_settings(env_file=...) explicitly.
#
# Syntax: KEY=VALUE lines, # comment lines, optional `export` prefix and
# quotes, a ` # comment` after a bare value. No interpolation, no multi-line
# values. A base install reads this file; the cloud extra is only for Gemini.

# Default backend when --backend is not given: "local" (Ollama) or "api" (Gemini).
LLM_BACKEND=local

# --- Local backend (Ollama) --------------------------------------------------
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:3b
# Base URL of the Ollama server; unset uses the SDK default (http://localhost:11434).
# OLLAMA_HOST=http://ollama:11434

# --- Cloud backend (Google Gemini) -------------------------------------------
# The Gemini Developer API (option A) is verified against the real service;
# Vertex AI (option B) is not yet. Tracked in
# https://github.com/deluispablo/data-agent-toolkit/issues/92
#
# Provide ONE of the two options below. If both are set, the API key wins.
#
# Option A: Gemini Developer API with an API key (https://aistudio.google.com/apikey).
# Never commit a real key.
GEMINI_API_KEY=
#
# Option B: Vertex AI with Application Default Credentials
# (run `gcloud auth application-default login` first).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

CLOUD_MODEL=gemini-3.6-flash
CLOUD_FALLBACK_MODEL=gemini-flash-lite-latest
